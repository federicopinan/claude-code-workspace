{
  "name": "claude-code-workspace-template",
  "version": "0.1.0",
  "private": true,
  "description": "Reusable Claude Code workspace template for systematic app development.",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "setup": "bash scripts/setup.sh",
    "new:app": "bash scripts/new-app.sh",
    "check:template": "bash scripts/check-template.sh",
    "lint": "npm run lint --workspace apps/mi-primer-app",
    "format": "npm run format --workspace apps/mi-primer-app",
    "format:check": "npm run format:check --workspace apps/mi-primer-app",
    "typecheck": "npm run typecheck --workspace apps/mi-primer-app",
    "test": "npm test --workspace apps/mi-primer-app",
    "test:e2e": "npm run test:e2e --workspace apps/mi-primer-app",
    "check": "npm run check:template && npm run format:check && npm run lint && npm run typecheck && npm test"
  },
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=10.0.0"
  },
  "overrides": {
    "postcss": "^8.5.10"
  }
}
